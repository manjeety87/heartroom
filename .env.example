# Heartroom environment variables: NAMES ONLY. This repo is public.
# Copy to .env.local (git-ignored) and fill in values there. Each app's config module
# zod-parses these at boot and refuses to start on a missing or malformed one.
# An empty value (KEY=) means "unset".

# ── shared ───────────────────────────────────────────────────────────────
# Neon Postgres, pooled URL (runtime). Migrations use the direct URL (same host without -pooler).
# Leave both empty locally: the site and the game server then use the database `pnpm dev` starts
# (PGlite on 127.0.0.1:5433, data in .data/pglite, git-ignored). Required in production.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ── web (apps/web) ───────────────────────────────────────────────────────
# Better Auth signing secret, 32+ characters (e.g. `openssl rand -base64 32`). Required on Vercel;
# empty locally uses a fixed development secret.
AUTH_SECRET=
# Public origin of the site. Required on Vercel; empty locally means "the address in the request".
AUTH_URL=
# Google OAuth "Web application" client. "Sign in with Google" appears only when both are set.
# Authorised redirect URI: <site origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WebSocket URL of the game server the browser connects to.
NEXT_PUBLIC_GAME_SERVER_URL=
NEXT_PUBLIC_SENTRY_DSN=

# ── game server (apps/server) ────────────────────────────────────────────
PORT=
# Comma-separated list of allowed Origins for WebSocket upgrades and CORS. Required in production
# (no wildcard); leave empty in development to allow every origin (phones on the LAN).
ALLOWED_ORIGINS=
# Number of trusted proxy hops in front of the server.
TRUST_PROXY=
# Better Auth JWKS endpoint used to verify player JWTs: <site>/api/auth/jwks. Required in
# production; empty in development means http://localhost:3000/api/auth/jwks.
AUTH_JWKS_URL=
# AES-256-GCM key for crash-recovery checkpoints: base64 of exactly 32 bytes.
CHECKPOINT_KEY=
# Previous key, accepted for opening checkpoints during a rotation.
CHECKPOINT_KEY_PREVIOUS=
SENTRY_DSN=
LOG_LEVEL=

# ── voice (LiveKit Cloud) ────────────────────────────────────────────────
# Game server only. Voice stays off until all three are set (cloud.livekit.io → project →
# Settings → Keys). LIVEKIT_URL is the project's wss:// URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── feature flags: true | false ──────────────────────────────────────────
VOICE_ENABLED=
# Voice minutes per calendar month (UTC); past it "Voice is resting this month". Unset = no cap.
# LiveKit sends webhooks to <game server>/livekit/webhook (set it in the LiveKit project settings).
VOICE_MONTHLY_CAP_MINUTES=
WORD_GUESS_ENABLED=
LEADERBOARD_ENABLED=
